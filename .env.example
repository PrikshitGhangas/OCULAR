# OCULAR Environment Configuration
# Copy this file to .env and adjust values for your system.

# Camera device index (0 = default webcam) or device path (/dev/video0 on Linux)
OCULAR_CAMERA=0

# Default calibration pattern: 5-point, 9-point, 13-point, 16-point
OCULAR_PATTERN=9-point

# Default ML model: ridge, svr, rf, mlp
OCULAR_MODEL=rf

# Calibration session output directory
OCULAR_CALIBRATION_DIR=calibration

# Trained model output directory
OCULAR_MODEL_DIR=models
